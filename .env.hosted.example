# Operator-only secrets. Never distribute this file to customers.
API_URL=https://promo-flow-api.vercel.app/api
WORKER_API_TOKEN=replace-with-the-same-server-secret-configured-in-the-api
ENABLE_PUBLISHING=false
MAX_CONCURRENT_SESSIONS=5
SESSION_START_TIMEOUT_MS=180000
QR_IN_TERMINAL=false
# Chromium may require disabling its sandbox inside the isolated Docker container.
CHROME_NO_SANDBOX=true
